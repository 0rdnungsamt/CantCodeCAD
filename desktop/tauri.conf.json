{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "cantcodecad",
  "version": "0.1.1",
  "identifier": "de.cantcodecad.desktop",
  "build": {
    "frontendDist": "stub"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico"
    ],
    "resources": {
      "../index.html": "web/index.html",
      "../src/": "web/src/",
      "../vendor/": "web/vendor/",
      "../Projekte/Beispiele/": "web/Projekte-Beispiele/",
      "../tools/nester_bridge.py": "web/tools/nester_bridge.py"
    },
    "shortDescription": "cantcodecad – lokales parametrisches CAD",
    "windows": {
      "nsis": {
        "installMode": "currentUser",
        "languages": [
          "German"
        ]
      }
    }
  }
}
